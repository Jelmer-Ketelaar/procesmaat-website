# Public site configuration (required for a production build)
NEXT_PUBLIC_DEPLOYMENT_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_SITE_EMAIL=info@procesmaatsoftware.nl
NEXT_PUBLIC_SITE_PHONE=
NEXT_PUBLIC_SITE_ADDRESS=
NEXT_PUBLIC_CHAMBER_OF_COMMERCE=
NEXT_PUBLIC_RETENTION_PERIOD=
NEXT_PUBLIC_SUBPROCESSORS=
NEXT_PUBLIC_LEGAL_REVIEW_COMPLETED=false

# Optional public builder profile; rendered only when all three values exist.
NEXT_PUBLIC_BUILDER_NAME=
NEXT_PUBLIC_BUILDER_ROLE=
NEXT_PUBLIC_BUILDER_BIO=
NEXT_PUBLIC_LINKEDIN_URL=

# Server-only lead delivery (configure as hosted secrets where supported).
# Formspree-endpoint: https://formspree.io/f/xjybpozg
LEAD_WEBHOOK_URL=https://formspree.io/f/xjybpozg
APP_ENV=development

# Set to true only after the documented Cloudflare WAF rate-limiting rule exists.
CLOUDFLARE_RATE_LIMITING_CONFIGURED=false
